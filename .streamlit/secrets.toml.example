# Copy the values into Streamlit Community Cloud: app > Settings > Secrets.
# (For local testing with Google Sheets, copy this file to secrets.toml and fill it in.
#  Never commit the real secrets.toml.)

# ID of your Google Sheet: the long string between /d/ and /edit in its URL.
sheet_key = "PASTE_SPREADSHEET_ID_HERE"

# Optional extra password on top of Streamlit's sharing settings.
APP_PASSWORD = "choose-a-long-password"

# Service account key JSON from Google Cloud, pasted field by field.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
# Copy the private_key value from the JSON file exactly: keep the \n sequences as they are.
private_key = "-----BEGIN PRIVATE KEY-----\n...rest of the key, one line per \n...\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
